# pnpm 전환 설정 — 반드시 hoisted 레이아웃을 유지한다.
#
# 이 모노레포는 npm의 평평한 호이스팅에 의존한다: babel-preset-expo가 루트
# node_modules에서 expo-router/reanimated를 require.resolve로 찾고(//mobileHoist),
# apps/mobile의 jest 설정도 루트 node_modules 경로를 직접 매핑한다.
# pnpm 기본(심볼릭 링크·엄격 격리)은 이 구조를 깨므로 node-linker=hoisted로
# npm과 동일한 레이아웃을 만들고, 속도 이득은 전역 스토어 하드링크에서 얻는다.
node-linker=hoisted

# 기존 npm --legacy-peer-deps 운용에 상응: peer 불일치로 설치를 실패시키지 않고,
# peer 자동 설치로 의존성 트리가 변형되는 것도 막는다(수동 호이스트 선언 유지).
strict-peer-dependencies=false
auto-install-peers=false

# 주의: store-dir은 여기(커밋되는 파일)에 넣지 말 것 — CI/EAS 리눅스 빌더에서
# 윈도우 경로가 깨진다. 로컬에서는 `pnpm config set store-dir D:\pnpm-store --global`
# 로 프로젝트와 같은 볼륨에 두어야 하드링크가 동작한다.
