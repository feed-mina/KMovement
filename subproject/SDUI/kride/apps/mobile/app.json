{
  "expo": {
    "name": "KRIDE",
    "slug": "kride-mobile",
    "scheme": "kride",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "의상 후보 분석에 사용할 사진을 직접 선택할 때만 사진 보관함에 접근합니다."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/cc4cddc4-e3df-446d-8f62-7d0d39dc77a2"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kride.mobile",
      "versionCode": 4
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cc4cddc4-e3df-446d-8f62-7d0d39dc77a2"
      }
    }
  }
}
