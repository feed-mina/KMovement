{
  "expo": {
    "name": "KRIDE",
    "slug": "kride-mobile",
    "scheme": "kride",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store"
