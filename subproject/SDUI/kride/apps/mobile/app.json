    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kride.mobile",
      "versionCode": 3
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cc4cddc4-e3df-446d-8f62-7d0d39dc77a2"
      }
    }
  }
}
