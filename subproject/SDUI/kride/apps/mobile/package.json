{
  "name": "@kride/mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "start:tunnel": "expo start --tunnel -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:android": "expo export --platform android --clear --max-workers 4",
    "eas:guard:preview": "node scripts/guard-eas-build.mjs preview",
    "eas:guard:production": "node scripts/guard-eas-build.mjs production",
    "eas:build:preview": "node scripts/guard-eas-build.mjs preview && eas build --platform android --profile preview",
    "eas:build:production": "node scripts/guard-eas-build.mjs production && eas build --platform android --profile production",
    "eas:update:preview": "eas update --channel preview --environment preview --platform android --message",
    "eas:update:production": "eas update --channel production --environment production --platform android --message",
    "test": "jest"
  },
  "dependencies": {
    "@kride/core": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "4.5.2",
    "@tanstack/react-query": "^5.21.4",
    "expo": "~51.0.0",
    "expo-file-system": "~17.0.1",
    "expo-image-picker": "~15.1.0",
    "expo-router": "~3.5.23",
    "expo-secure-store": "^13.0.2",
    "expo-updates": "^0.25.28",
    "nativewind": "4.1.23",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-css-interop": "0.1.22",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "eas-cli": "^21.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3"
  }
}
