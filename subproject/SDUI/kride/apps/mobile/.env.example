# Copy to `.env` (gitignored) before running Metro. Expo loads EXPO_PUBLIC_*
# vars automatically and inlines them into the bundle — keep secrets out.
#
# Required. Without it the app falls back to an empty apiBase and every request
# goes to a relative path like `/api/auth/login`, which React Native cannot
# resolve — login fails with no obvious cause.
#
# Must be reachable *from the phone*:
#   - Deployed server (simplest; same host the EAS profiles use):
EXPO_PUBLIC_API_BASE=https://yerin.duckdns.org
#
#   - Local backend: use this machine's LAN IP, never localhost/127.0.0.1 —
#     on the phone those resolve to the phone itself.
#     Find it with `ipconfig` (IPv4 Address), then:
# EXPO_PUBLIC_API_BASE=http://192.168.0.10:8080
