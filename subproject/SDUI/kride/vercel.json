{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . && exit 0 || exit 1"
}
