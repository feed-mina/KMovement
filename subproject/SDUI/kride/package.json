{
  "name": "kride",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "packages/core",
    "apps/mobile"
  ],
  "scripts": {
    "lint": "eslint",
    "test": "pnpm --filter @kride/mobile test"
  },
  "//mobileHoist": "RN community modules with native code must also be declared in apps/mobile/package.json so React Native native autolinking (Gradle/CocoaPods) can discover them. Root declarations only provide npm workspace hoisting and do not replace app-local declarations. Expo Router and its Expo peers remain hoisted here so babel-preset-expo and Expo native modules can resolve them.",
  "dependencies": {
    "@kride/core": "workspace:*",
    "@tanstack/react-query": "^5.21.4",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "react-native": "0.74.5",
    "@react-native/virtualized-lists": "0.74.87"
  },
  "pnpm": {
    "overrides": {
      "react-native": "0.74.5",
      "@react-native/virtualized-lists": "0.74.87"
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "eslint": "^8",
    "jest": "^29.7.0",
    "typescript": "^5.2"
  }
}
