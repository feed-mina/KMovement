FROM python:3.11-slim

WORKDIR /app

# Keep this shared prefix identical in both K-Ride runtime Dockerfiles. Docker reuses the
# large CPU Torch and application dependency layers across the API and worker
# images instead of storing two copies on the deployment host.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY src/api/requirements-docker.txt /tmp/requirements.txt
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# End of the shared K-Ride dependency layers.

# Worker-only media dependencies stay after the shared boundary and before
# application source, so normal code changes do not rebuild these large layers.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/media_motion/requirements.txt /tmp/requirements-media.txt
RUN pip install --no-cache-dir -r /tmp/requirements-media.txt

COPY src/ /app/src/
COPY deploy/ /app/deploy/

CMD ["celery", "-A", "src.api.celery_app", "worker", "-l", "info", "-c", "1", "-Q", "media"]
