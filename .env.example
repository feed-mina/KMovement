# Local Docker Compose defaults.
# Fill in only the integrations used by your environment.

INTERNAL_API_KEY=sdui-internal-dev-key
FASTAPI_INTERNAL_API_KEY=sdui-internal-dev-key

# Celery media progress/cleanup tuning (Compose supplies broker/backend URLs).
CELERY_TEMP_TTL_HOURS=6
CELERY_SSE_POLL_INTERVAL_SECONDS=1
CELERY_SSE_HEARTBEAT_SECONDS=15
CELERY_SSE_MAX_DURATION_SECONDS=2100
# Enable only when a worker is actively consuming the ml queue.
CELERY_ML_TASKS_ENABLED=false


SUPABASE_URL=
SUPABASE_KEY=
GROQ_API_KEY=

RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TORA_ENDPOINT_ID=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
