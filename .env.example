# Local Docker Compose defaults.
# Fill in only the integrations used by your environment.

INTERNAL_API_KEY=sdui-internal-dev-key
FASTAPI_INTERNAL_API_KEY=sdui-internal-dev-key

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

SUPABASE_URL=
SUPABASE_KEY=
GROQ_API_KEY=

RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TORA_ENDPOINT_ID=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Calendar / OAuth
# Register a Google Cloud OAuth 2.0 client (Web application type).
# Add the redirect URI to the client's "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yerin.duckdns.org/view/GOOGLE_CALLBACK

# Slack Incoming Webhook / Bot
# Create a Slack app at https://api.slack.com/apps.
# - Incoming Webhooks: enable and copy the webhook URL.
# - Bot Token Scopes: chat:write (needed for bot-token-based posting).
# - SLACK_TARGET_USER_ID: Slack member ID (e.g. U0XXXXXXXXX) for @mentions.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_TARGET_USER_ID=U0AM4840JFR
