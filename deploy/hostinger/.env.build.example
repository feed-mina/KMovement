# These values are build inputs for the web-only image. They are not loaded by
# web.compose.yml at runtime because Next.js rewrites and NEXT_PUBLIC values are
# embedded during `next build`.
NEXT_PUBLIC_SITE_URL=https://kmovement-preview.example.com
NEXT_PUBLIC_BACKEND_URL=http://disabled-spring:8080
FASTAPI_URL=http://disabled-fastapi:8000

# Required for the first feature: address selection -> coordinates -> Kakao map.
# This is a browser-visible JavaScript key; restrict its allowed domains in
# Kakao Developers. Do not commit a real value here.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Out of scope for the first feature. Keep empty unless the verification scope
# is explicitly expanded.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
