# Tora CogVideoX-5B I2V — Trajectory-controlled Image-to-Video
# Official Tora environment: Python 3.10, PyTorch 2.4.0, CUDA 12.1
#
# Build:
#   docker build -f deploy/media_motion/Dockerfile.tora -t kride-tora-gpu .
#
# Run:
#   docker run --gpus all -p 8000:8000 \
#     -v /path/to/network-volume:/runpod-volume \
#     kride-tora-gpu

FROM ghcr.io/pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KRIDE_MEDIA_DIR=/app/media \
    KRIDE_WORKER_OUTPUT_DIR=/tmp/kride_outputs \
    KRIDE_WORKER_ALLOW_FALLBACK=true \
    KRIDE_COGVIDEOX_CPU_OFFLOAD=true \
    KRIDE_RESULT_URL_REQUIRED=true \
    KRIDE_MAX_INLINE_OUTPUT_BYTES=6291456 \
    KRIDE_TORA_DIR=/app/Tora \
    KRIDE_TORA_CHECKPOINT_PATH=/runpod-volume/tora/i2v/mp_rank_00_model_states.pt \
    KRIDE_TORA_ENABLED=true \
    KRIDE_COGVIDEOX_MODEL_ID=zai-org/CogVideoX-5b-I2V \
    KRIDE_ANIMATED_DRAWINGS_DIR=/app/AnimatedDrawings \
    KRIDE_ANIMATED_DRAWINGS_PYTHON=/opt/miniconda/envs/ad_env/bin/python \
    PYOPENGL_PLATFORM=osmesa \
    HF_HOME=/runpod-volume/huggingface-cache \
    HUGGINGFACE_HUB_CACHE=/runpod-volume/huggingface-cache/hub

WORKDIR /app

# ─────────────────────────────────────────────────────────────────────────────
# System dependencies
# ─────────────────────────────────────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg git curl wget \
        pkg-config \
        libosmesa6 libosmesa6-dev \
        freeglut3-dev libglfw3-dev \
        libgl1-mesa-glx libglib2.0-0 \
        openjdk-17-jre-headless && \
    rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────────
# Tora repository (commit SHA pinned for reproducibility)
# ─────────────────────────────────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/alibaba/Tora.git /app/Tora && \
    cd /app/Tora && git log --oneline -1

# SwissArmyTransformer (Tora dependency)
RUN cd /app/Tora/modules/SwissArmyTransformer && pip install --no-cache-dir -e .

# Tora sat requirements
RUN cd /app/Tora/sat && pip install --no-cache-dir -r requirements.txt

# AnimatedDrawings uses an isolated Python 3.8 environment because its
# torch/mmcv stack is incompatible with Tora's Python 3.10 + torch 2.4 runtime.
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-py38_23.11.0-2-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/miniconda && \
    rm /tmp/miniconda.sh && \
    /opt/miniconda/bin/conda create -n ad_env python=3.8 -y && \
    /opt/miniconda/bin/conda clean -afy

RUN git clone --depth 1 https://github.com/facebookresearch/AnimatedDrawings.git /app/AnimatedDrawings && \
    cd /app/AnimatedDrawings && \
    sed -i "s/'controller': {/'view': {'USE_MESA': True},\n        'controller': {/" \
        examples/annotations_to_animation.py || true

ENV AD_PIP=/opt/miniconda/envs/ad_env/bin/pip

RUN ${AD_PIP} install --upgrade pip "setuptools==65.5.0" wheel six && \
    (${AD_PIP} install chumpy --no-build-isolation || \
     ${AD_PIP} install git+https://github.com/mattloper/chumpy.git --no-build-isolation)

RUN ${AD_PIP} install \
        "torch==1.13.1+cu116" \
        "torchvision==0.14.1+cu116" \
        "torchaudio==0.13.1" \
        --extra-index-url https://download.pytorch.org/whl/cu116

RUN ${AD_PIP} install \
        "mmcv-full==1.7.0" \
        -f https://download.openmmlab.com/mmcv/dist/cu116/torch1.13.0/index.html \
        --timeout 30 --retries 1 || \
    (${AD_PIP} install "mmcv-full==1.7.0" --timeout 60) || \
    (${AD_PIP} install openmim && \
     /opt/miniconda/envs/ad_env/bin/mim install "mmcv-full==1.7.0")

RUN ${AD_PIP} install \
        "mmdet==2.28.2" "mmpose==0.28.1" "numpy<2" \
        scikit-image scikit-learn \
        "PyOpenGL==3.1.7" \
        imageio imageio-ffmpeg shapely pillow pyyaml requests tqdm matplotlib \
        opencv-python-headless && \
    (${AD_PIP} install PyOpenGL-accelerate || true) && \
    cd /app/AnimatedDrawings && \
    ${AD_PIP} install --no-cache-dir -e . --quiet

RUN ${AD_PIP} install --no-cache-dir "torchserve==0.7.1" && \
    mkdir -p /home/torchserve/model-store && \
    wget -q https://github.com/facebookresearch/AnimatedDrawings/releases/download/v0.0.1/drawn_humanoid_detector.mar \
        -O /home/torchserve/model-store/drawn_humanoid_detector.mar && \
    wget -q https://github.com/facebookresearch/AnimatedDrawings/releases/download/v0.0.1/drawn_humanoid_pose_estimator.mar \
        -O /home/torchserve/model-store/drawn_humanoid_pose_estimator.mar

COPY deploy/media_motion/torchserve_config.properties /home/torchserve/config.properties

# ─────────────────────────────────────────────────────────────────────────────
# Python dependencies — KRIDE worker
# ─────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir "numpy<2"

COPY deploy/media_motion/requirements.txt /tmp/req-base.txt
RUN pip install --no-cache-dir -r /tmp/req-base.txt

COPY deploy/media_motion/requirements-tora.txt /tmp/req-tora.txt
RUN pip install --no-cache-dir -r /tmp/req-tora.txt

# CogVideoX I2V pipeline (used as fallback when Tora fails)
COPY deploy/media_motion/requirements-cogvideox.txt /tmp/req-cogvideox.txt
RUN pip install --no-cache-dir -r /tmp/req-cogvideox.txt

# sentencepiece — required by MarianMT (BLIP-2 caption translation)
RUN pip install --no-cache-dir sentencepiece

# RunPod SDK
RUN pip install --no-cache-dir "runpod>=1.7,<2"

# opencv-python-headless (depth parallax fallback)
# OpenCV 4.12+ requires NumPy 2.x, while Tora/SciPy still require NumPy 1.x.
RUN pip install --no-cache-dir "opencv-python-headless<4.12" "numpy<2"

# ─────────────────────────────────────────────────────────────────────────────
# Verify core versions survived dependency installs (Tora/SAT may change them)
# ─────────────────────────────────────────────────────────────────────────────
RUN python -c "import numpy, torch; tv=torch.__version__; nv=numpy.__version__; print('PyTorch:', tv, 'NumPy:', nv); assert tv.startswith('2.'), f'Expected PyTorch 2.x but got {tv}'; assert int(nv.split('.')[0]) < 2, f'Expected NumPy 1.x but got {nv}'"

# ─────────────────────────────────────────────────────────────────────────────
# MusicGen BGM (optional). audiocraft may perturb the pinned torch 2.4.0 / NumPy
# <2 stack that Tora's SAT inference depends on, so install it, then re-pin and
# re-verify. If audiocraft cannot coexist, the worker degrades to sine-wave BGM
# (handled in tora_cogvideox_real._resolve_bgm) while Tora inference stays intact.
# ─────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir "audiocraft>=1.3,<2" \
    || echo "WARN: audiocraft install failed — sine-wave BGM fallback will be used"
RUN pip install --no-cache-dir "torch==2.4.0" "torchaudio==2.4.0" "numpy<2" \
    || echo "WARN: torch/numpy re-pin after audiocraft failed"
RUN python -c "import numpy, torch; tv=torch.__version__; nv=numpy.__version__; print('PyTorch:', tv, 'NumPy:', nv); assert tv.startswith('2.4'), f'Tora needs torch 2.4.x, got {tv}'; assert int(nv.split('.')[0]) < 2, f'Tora needs numpy 1.x, got {nv}'"

# ─────────────────────────────────────────────────────────────────────────────
# Pre-download small model weights only (<500MB)
# CogVideoX-5b-I2V (~30GB) is NOT pre-downloaded — it downloads at first request
# and is cached on RunPod Network Volume for subsequent calls.
# ─────────────────────────────────────────────────────────────────────────────
RUN python -c "from transformers import BlipProcessor, BlipForConditionalGeneration; BlipProcessor.from_pretrained('Salesforce/blip-image-captioning-base'); BlipForConditionalGeneration.from_pretrained('Salesforce/blip-image-captioning-base')" \
    || echo "WARN: BLIP pre-download failed"

# ─────────────────────────────────────────────────────────────────────────────
# Application code
# ─────────────────────────────────────────────────────────────────────────────
COPY deploy /app/deploy

RUN mkdir -p /tmp/kride_outputs /app/media

# Tora's sat configs reference the VAE and T5 encoder via the *relative* path
# `ckpts/...` (resolved from KRIDE_TORA_DIR=/app/Tora). Point that at the network
# volume so the large weights live on the volume instead of being baked in.
# Dangling at build time; resolves once the network volume mounts at runtime.
RUN ln -sfn /runpod-volume/tora-ckpts /app/Tora/ckpts

# RunPod Network Volume layout expected at runtime:
#   /runpod-volume/tora/i2v/mp_rank_00_model_states.pt   (transformer, via --load)
#   /runpod-volume/tora-ckpts/vae/3d-vae.pt              (ckpts/vae/3d-vae.pt)
#   /runpod-volume/tora-ckpts/t5-v1_1-xxl/               (ckpts/t5-v1_1-xxl)

COPY deploy/media_motion/tora_entrypoint.sh /app/tora_entrypoint.sh
RUN chmod +x /app/tora_entrypoint.sh

ENTRYPOINT ["/app/tora_entrypoint.sh"]
