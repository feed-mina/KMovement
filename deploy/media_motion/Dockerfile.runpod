# RunPod Serverless GPU Image for K-Ride Media Motion
# Models: AnimatedDrawings (conda py3.8), CogVideoX, MusicGen, gTTS, FFmpeg fallbacks
#
# AnimatedDrawings requires Python 3.8 + torch 1.13 + mmcv/mmdet/mmpose
# while CogVideoX/MusicGen use Python 3.11 + a Blackwell-compatible PyTorch.
# Solution: Miniconda creates an isolated py3.8 env for AnimatedDrawings,
# the main py3.11 handles everything else.
#
# Build (no GPU needed):
#   docker build -f deploy/media_motion/Dockerfile.runpod -t kride-media-gpu .
#
# Local test:
#   docker run --gpus all -p 8000:8000 kride-media-gpu

FROM ghcr.io/pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KRIDE_MEDIA_DIR=/app/media \
    KRIDE_WORKER_OUTPUT_DIR=/tmp/kride_outputs \
    KRIDE_WORKER_ALLOW_FALLBACK=true \
    KRIDE_COGVIDEOX_CPU_OFFLOAD=true \
    KRIDE_RESULT_URL_REQUIRED=true \
    KRIDE_MAX_INLINE_OUTPUT_BYTES=6291456 \
    MUSICGEN_MODEL=facebook/musicgen-small \
    KRIDE_ANIMATED_DRAWINGS_DIR=/app/AnimatedDrawings \
    KRIDE_ANIMATED_DRAWINGS_PYTHON=/opt/miniconda/envs/ad_env/bin/python \
    PYOPENGL_PLATFORM=osmesa

WORKDIR /app

# ─────────────────────────────────────────────────────────────────────────────
# System dependencies (ffmpeg + OSMesa + Redis + supervisord)
# ─────────────────────────────────────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        pkg-config \
        libavformat-dev libavcodec-dev libavdevice-dev \
        libavutil-dev libswscale-dev libswresample-dev libavfilter-dev \
        libosmesa6 libosmesa6-dev \
        freeglut3-dev libglfw3-dev \
        libgl1-mesa-glx \
        libglib2.0-0 \
        git curl wget \
        redis-server supervisor && \
    rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────────
# AnimatedDrawings — isolated Python 3.8 conda environment
# (matches Kaggle/Colab tested setup from track_b_requirements_notes.md)
# ─────────────────────────────────────────────────────────────────────────────

# Install Miniconda
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-py38_23.11.0-2-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/miniconda && \
    rm /tmp/miniconda.sh

# Create py3.8 environment for AnimatedDrawings
RUN /opt/miniconda/bin/conda create -n ad_env python=3.8 -y && \
    /opt/miniconda/bin/conda clean -afy

# Clone AnimatedDrawings
RUN git clone --depth 1 https://github.com/facebookresearch/AnimatedDrawings.git /app/AnimatedDrawings

# Patch annotations_to_animation.py to enable USE_MESA for headless rendering
RUN cd /app/AnimatedDrawings && \
    sed -i "s/'controller': {/'view': {'USE_MESA': True},\n        'controller': {/" \
        examples/annotations_to_animation.py || true

# Install AnimatedDrawings dependencies in conda env (tested versions from Kaggle)
ENV AD_PIP=/opt/miniconda/envs/ad_env/bin/pip

# Step 1: pip + build tools
RUN ${AD_PIP} install --upgrade pip "setuptools==65.5.0" wheel six

# Step 2: chumpy (needs --no-build-isolation)
RUN ${AD_PIP} install chumpy --no-build-isolation || \
    ${AD_PIP} install git+https://github.com/mattloper/chumpy.git --no-build-isolation

# Step 3: PyTorch 1.13 + cu116
RUN ${AD_PIP} install \
        "torch==1.13.1+cu116" \
        "torchvision==0.14.1+cu116" \
        "torchaudio==0.13.1" \
        --extra-index-url https://download.pytorch.org/whl/cu116

# Step 4: mmcv-full (try prebuilt wheel, fall back to source build)
RUN ${AD_PIP} install \
        "mmcv-full==1.7.0" \
        -f https://download.openmmlab.com/mmcv/dist/cu116/torch1.13.0/index.html || \
    ( echo "WARN: prebuilt mmcv-full wheel unavailable, building from source..." && \
      ${AD_PIP} install "mmcv-full==1.7.0" )

# Step 5: mmdet + mmpose
RUN ${AD_PIP} install "mmdet==2.28.2" "mmpose==0.28.1"

# Pin numpy<2 in conda env
RUN ${AD_PIP} install "numpy<2"

# Step 6: other Python deps
RUN ${AD_PIP} install \
        scikit-image scikit-learn \
        "PyOpenGL==3.1.7" \
        imageio imageio-ffmpeg shapely \
        pillow pyyaml requests tqdm matplotlib \
        opencv-python-headless

# Step 6b: PyOpenGL-accelerate (optional, may fail to compile)
RUN ${AD_PIP} install PyOpenGL-accelerate || echo "WARN: PyOpenGL-accelerate skipped — software rendering only"

# Install AnimatedDrawings package itself in the conda env
RUN cd /app/AnimatedDrawings && \
    ${AD_PIP} install --no-cache-dir -e . --quiet

# ─────────────────────────────────────────────────────────────────────────────
# Main Python 3.11 env — CogVideoX, MusicGen, gTTS, RunPod handler
# ─────────────────────────────────────────────────────────────────────────────

# Pin numpy<2 before any other installs to prevent NumPy 2.x incompatibility
RUN pip install --no-cache-dir "numpy<2"

# Python dependencies — base (gTTS, soundfile)
COPY deploy/media_motion/requirements.txt /tmp/req-base.txt
RUN pip install --no-cache-dir -r /tmp/req-base.txt

# Python dependencies — GPU models (CogVideoX)
COPY deploy/media_motion/requirements-cogvideox.txt /tmp/req-cogvideox.txt
RUN pip install --no-cache-dir -r /tmp/req-cogvideox.txt

# Python dependencies — MusicGen (optional: falls back to sine-wave BGM)
RUN pip install --no-cache-dir "audiocraft>=1.3,<2" || echo "WARN: audiocraft install failed — sine-wave BGM fallback will be used"

# Celery + Redis broker for parallel TTS/BGM tasks
RUN pip install --no-cache-dir "celery[redis]>=5.3,<6"

# GPT-SoVITS (optional: falls back to gTTS)
RUN git clone --depth 1 https://github.com/RVC-Boss/GPT-SoVITS.git /app/GPT-SoVITS || echo "WARN: GPT-SoVITS clone failed"
RUN apt-get update && apt-get install -y --no-install-recommends \
        libmecab-dev mecab && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir mecab-python3 mecab-ko-dic bigvgan julius \
    || echo "WARN: GPT-SoVITS deps partial install"

# sentencepiece — required by MarianMT (BLIP-2 caption translation)
RUN pip install --no-cache-dir sentencepiece

# RunPod SDK
RUN pip install --no-cache-dir "runpod>=1.7,<2"

# Guard against optional packages replacing the Blackwell-compatible torch build.
RUN pip install --no-cache-dir --upgrade \
        "torch==2.7.1" \
        "torchvision==0.22.1" \
        "torchaudio==2.7.1" \
        --index-url https://download.pytorch.org/whl/cu128 && \
    python -c "import torch; assert torch.__version__.startswith('2.7.1'), torch.__version__; assert torch.version.cuda == '12.8', torch.version.cuda; print('torch OK:', torch.__version__, 'cuda', torch.version.cuda)"

# ─────────────────────────────────────────────────────────────────────────────
# Pre-download model weights (before COPY so layer is cached across code changes)
# ─────────────────────────────────────────────────────────────────────────────
RUN python -c "from diffusers import CogVideoXImageToVideoPipeline; CogVideoXImageToVideoPipeline.from_pretrained('THUDM/CogVideoX-2b')" || echo "WARN: CogVideoX pre-download failed — will download at runtime"
RUN python -c "from audiocraft.models import MusicGen; MusicGen.get_pretrained('facebook/musicgen-small')" || echo "WARN: MusicGen pre-download failed — sine-wave fallback available"
RUN python -c "from transformers import BlipProcessor, BlipForConditionalGeneration; BlipProcessor.from_pretrained('Salesforce/blip-image-captioning-base'); BlipForConditionalGeneration.from_pretrained('Salesforce/blip-image-captioning-base')" || echo "WARN: BLIP pre-download failed — will download at runtime"
RUN python -c "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM; AutoTokenizer.from_pretrained('Helsinki-NLP/opus-mt-en-ko'); AutoModelForSeq2SeqLM.from_pretrained('Helsinki-NLP/opus-mt-en-ko')" || echo "WARN: MarianMT pre-download failed — will download at runtime"

# ─────────────────────────────────────────────────────────────────────────────
# Application code (changes here do NOT re-download models)
# ─────────────────────────────────────────────────────────────────────────────
COPY deploy /app/deploy

# supervisord config for Redis → Celery → RunPod handler process management
COPY deploy/media_motion/supervisord.conf /etc/supervisor/conf.d/kride.conf

RUN mkdir -p /tmp/kride_outputs /app/media

ENV KRIDE_GPT_SOVITS_DIR=/app/GPT-SoVITS

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/kride.conf"]
